# Parametros comunes a todo el experimento. Los leen scripts/config.py y, a traves de el, los notebooks.
# No contiene credenciales, asi que se versiona. Cambiar SEMILLA o N_FOLDS invalida el registro de
# experimentos (outputs/experimentos.csv) y los folds guardados: obliga a recalcularlo todo.

# Semilla de toda la aleatoriedad (particion, folds, modelos, bootstrap)
SEMILLA=42
# La particion train/test usa 1 de N_PARTES partes como test (5 -> 20% de test)
N_PARTES=5
# Folds de la validacion cruzada y repeticiones guardadas en outputs/folds_cv.csv
N_FOLDS=5
N_REPETICIONES_CV=3
# Intervalo de precio: cobertura nominal (cuantiles 0,1 y 0,9) y replicas del bootstrap por anfitrion
COBERTURA_NOMINAL=0.8
N_REPLICAS_BOOTSTRAP=2000
